# ==============================================================================
# UBUNTU LEDGER (WARD PROOF-LINE) — LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================
# The system operates out-of-the-box in memory without requiring external services.
# Copy this file to .env.local for local overrides: cp .env.example .env.local

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Database Connection (Optional for in-memory demo; required for live PostgreSQL)
# Default local Supabase connection:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Security & Cryptography Secrets
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-bytes-long!
CRON_SECRET=dev-cron-secret-for-local-testing-only-32c!

# Channel Mode ('simulator' | 'live')
# In 'simulator' mode, all USSD and IVR sessions are simulated in-browser.
CHANNEL_MODE=simulator

# Pepper for salted phone number hashing (Zero-PII guarantee)
PHONE_PEPPER=dev-pepper-strictly-synthetic-32c-must-override-in-prod
